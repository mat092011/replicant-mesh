# Consumer-only secure client: no model runtime or model artifacts.
FROM python:3.12.15-slim-bookworm@sha256:2ed6491b93cd49272ee6de2b5a38440c3448360322c089fc23e370722d74179d

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src:/app
WORKDIR /app

COPY docker/participant-connector/consumer-requirements.lock /tmp/consumer-requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes --no-index \
        --only-binary=:all: \
        -r /tmp/consumer-requirements.lock \
    && python -m pip check

COPY src/steamboat_connector /app/src/steamboat_connector
COPY src/steamboat_security /app/src/steamboat_security
COPY src/steamboat_runtime /app/src/steamboat_runtime
COPY tests/connector/__init__.py /app/tests/connector/__init__.py
COPY tests/security/__init__.py /app/tests/security/__init__.py
COPY tests/connector/test_consumer_transport.py /app/tests/connector/test_consumer_transport.py
COPY tests/connector/test_validation_client.py /app/tests/connector/test_validation_client.py
COPY tests/security/test_channel_certificates.py /app/tests/security/test_channel_certificates.py
COPY tests/security/test_channel_policy.py /app/tests/security/test_channel_policy.py
COPY scripts/check_participant_consumer.py /app/scripts/check_participant_consumer.py

USER 65534:65534
CMD ["python", "-B", "scripts/check_participant_consumer.py"]
